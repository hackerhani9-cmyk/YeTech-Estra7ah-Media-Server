const fs = require('fs');
const path = require('path');
const db = require('./db');

function scanMediaDirectory(dirPath = path.join(__dirname, '..', 'media')) {
  const segments = [];

  if (!fs.existsSync(dirPath)) {
    return segments;
  }

  const files = fs.readdirSync(dirPath, { withFileTypes: true });

  files.forEach((entry) => {
    const fullPath = path.join(dirPath, entry.name);
    if (entry.isDirectory()) {
      segments.push(...scanMediaDirectory(fullPath));
      return;
    }

    if (['.mp4', '.mkv', '.m3u8', '.mp3', '.apk', '.pdf', '.png', '.jpg', '.jpeg'].includes(path.extname(entry.name).toLowerCase())) {
      const relativePath = path.relative(path.join(__dirname, '..'), fullPath).replace(/\\/g, '/');
      segments.push({ name: entry.name, path: relativePath, size: fs.statSync(fullPath).size });
    }
  });

  return segments;
}

function syncMediaIndex() {
  const scanned = scanMediaDirectory();
  const insertOrUpdate = db.prepare(`
    INSERT INTO media_items (title, type, file_path, file_size, duration, category, poster_url, description, updated_at)
    VALUES (?, ?, ?, ?, ?, ?, ?, ?, datetime('now'))
    ON CONFLICT(title) DO UPDATE SET file_path = excluded.file_path, file_size = excluded.file_size, updated_at = datetime('now')
  `);

  scanned.forEach((item) => {
    const ext = path.extname(item.name).toLowerCase();
    let type = 'movie';
    if (ext === '.mp3') type = 'audio';
    if (ext === '.apk') type = 'app';
    if (ext === '.pdf') type = 'book';
    if (ext === '.m3u8') type = 'live';

    insertOrUpdate.run(
      path.basename(item.name, ext),
      type,
      item.path,
      item.size,
      1200,
      'Local Collection',
      '',
      `Indexed from local disk: ${item.name}`
    );
  });

  return scanned;
}

module.exports = { scanMediaDirectory, syncMediaIndex };
